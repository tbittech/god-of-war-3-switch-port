+        if (s_idle_at[c] && now > s_idle_at[c] && idle >= s_idle_last[c])
+            load[c] = 100.0 * (1.0 - (double)(idle - s_idle_last[c]) / (double)(now - s_idle_at[c]));
+        s_idle_last[c] = idle; s_idle_at[c] = now;
+    }
+    svcSetThreadCoreMask(SPROF_CUR_THREAD, pref, (uint32_t)mask);
+}
+#endif
+__thread sprof_slot* t_sprof;
+static sprof_slot s_sprof[SPROF_SLOTS];
+static int s_sprof_period = -1;                 /* -1 = environment not read */
+static pthread_mutex_t s_sprof_reg = PTHREAD_MUTEX_INITIALIZER;
+
+static uint64_t s_sp_runs[SPROF_WIDS], s_sp_empty[SPROF_WIDS], s_sp_wake[SPROF_WIDS],
+                s_sp_wake_max[SPROF_WIDS], s_sp_wake_slow[SPROF_WIDS], s_sp_run[SPROF_WIDS],
+                s_sp_run_max[SPROF_WIDS];
+static uint64_t s_sp_pass, s_sp_kickpass, s_sp_disp, s_sp_disp_probe;
+
+#define SP_ADD(v, n) __atomic_fetch_add(&(v), (uint64_t)(n), __ATOMIC_RELAXED)
+#define SP_TAKE(v)   __atomic_exchange_n(&(v), (uint64_t)0, __ATOMIC_RELAXED)
+
+static uint64_t sprof_clock_us(void)
+{
+    struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000ull + (uint64_t)ts.tv_nsec / 1000ull;
+}
+uint64_t sprof_now_us(void) { return s_sprof_period > 0 ? sprof_clock_us() : 0; }
+
+void sprof_pm_run(uint32_t wid, uint64_t wake_us, uint64_t run_us, unsigned polls)
+{
+    if (s_sprof_period <= 0 || wid >= SPROF_WIDS) return;
+    if (wake_us > 10000000ull) wake_us = 0;     /* no stamp yet */
+    SP_ADD(s_sp_runs[wid], 1); SP_ADD(s_sp_wake[wid], wake_us); SP_ADD(s_sp_run[wid], run_us);
+    if (!polls) SP_ADD(s_sp_empty[wid], 1);
+    if (wake_us > 2000) SP_ADD(s_sp_wake_slow[wid], 1);
+    if (wake_us > s_sp_wake_max[wid]) s_sp_wake_max[wid] = wake_us;   /* racy maxima: a diagnostic */
+    if (run_us > s_sp_run_max[wid]) s_sp_run_max[wid] = run_us;
+}
+void sprof_kernel_pass(int kick_pass)
+{
+    if (s_sprof_period <= 0) return;
+    SP_ADD(s_sp_pass, 1); if (kick_pass) SP_ADD(s_sp_kickpass, 1);
+}
+void sprof_kernel_dispatch(int kicked)
+{
+    if (s_sprof_period <= 0) return;
+    SP_ADD(s_sp_disp, 1); if (!kicked) SP_ADD(s_sp_disp_probe, 1);
+}
+
+static void* sprof_sampler(void* p)
+{
+    (void)p;
+    static uint64_t key[SPROF_KEYS]; static uint32_t hit[SPROF_KEYS];
+    static uint32_t tot[SPROF_SLOTS], by[SPROF_SLOTS][SPROF_NSTATES];
+    static const char* const nm[SPROF_NSTATES] = { "out", "idle", "dispatch", "run", "interp",
+        "chwait", "lock", "sigwait", "ksleep", "kscan" };
+    for (;;) {
+        memset(key, 0, sizeof key); memset(hit, 0, sizeof hit);
+        memset(tot, 0, sizeof tot); memset(by, 0, sizeof by);
+        const uint64_t t0 = sprof_clock_us();
+        while (sprof_clock_us() - t0 < (uint64_t)s_sprof_period * 1000000ull) {
+            usleep(2000);
+            for (unsigned k = 0; k < SPROF_SLOTS; k++) {
+                sprof_slot* s = &s_sprof[k];
+                if (!s->used) continue;
+                const uint32_t st = s->st;
+                if (st >= SPROF_NSTATES) continue;
+                tot[k]++; by[k][st]++;
+                uint32_t img = 0, pc = 0;
+                if (st == SPROF_INTERP) {
+                    const spu_context* c = (const spu_context*)s->ctx;
+                    if (!c) continue;
+                    img = (uint32_t)c->image_id; pc = c->pc & 0x3FC00u;
+                    /* 35a: name the resident jobmod overlay (ids 200+) for job-buffer pcs */
+                    if (c->resident_ovl >= 200 && (c->pc & 0x3FFFFu) >= 0x4000u) img = (uint32_t)c->resident_ovl;
+                    for (int _s = 0; _s < 4; _s++) {
+                        uint32_t _p = c->pc & 0x3FFFFu;
+                        if (c->resident_code[_s].image_id >= 200 && _p >= c->resident_code[_s].lsa &&
+                            _p < c->resident_code[_s].lsa + c->resident_code[_s].size) {
+                            img = (uint32_t)c->resident_code[_s].image_id; break; }
+                    }
+                } else if (st == SPROF_RUN) {
+                    pc = s->br_pc; img = pc ? (uint32_t)s->br_img : s->arg;
+                } else if (st == SPROF_CHWAIT || st == SPROF_LOCK) {
+                    pc = s->arg;
+                } else continue;
+                const uint64_t kk = ((uint64_t)k << 58) | ((uint64_t)st << 54) |
+                                    ((uint64_t)img << 22) | (pc & 0x3FFFFFu);
+                unsigned i = (unsigned)((kk * 0x9E3779B97F4A7C15ull) >> 53) % SPROF_KEYS, n;
+                for (n = 0; n < SPROF_KEYS && key[i] && key[i] != kk; n++) i = (i + 1) % SPROF_KEYS;
+                if (n == SPROF_KEYS) continue;
+                key[i] = kk; hit[i]++;
+            }
+        }
+        const double secs = (double)(sprof_clock_us() - t0) / 1e6;
+        fprintf(stderr, "[sprof] %.1f s\n", secs);
+#ifdef __SWITCH__
+        double reg_tot = 0;
+#endif
+        for (unsigned k = 0; k < SPROF_SLOTS; k++) {
+            if (!tot[k]) continue;
+            char line[256]; int o = 0;
+            double cpu_all = 0;
+#ifdef __SWITCH__
+            {
+                uint64_t t;
+                if (sprof_ticks(s_sprof[k].nxh, &t)) {
+                    if (s_sprof[k].tick_ok && t >= s_sprof[k].tick)
+                        cpu_all = 100.0 * (double)(t - s_sprof[k].tick) / (SPROF_TICK_HZ * secs);
+                    s_sprof[k].tick = t; s_sprof[k].tick_ok = 1;
+                    reg_tot += cpu_all;
+                }
+            }
+#endif
+            if (s_sprof[k].kind == 'P') {              /* PPU threads: CPU only, when it matters */
+                if (cpu_all >= 1.0)
+                    fprintf(stderr, "[sprof] P%u (slot %u): cpu %.1f\n", s_sprof[k].who, k, cpu_all);
+                continue;
+            }
+            for (unsigned st = 0; st < SPROF_NSTATES && o < 220; st++)
+                if (by[k][st])
+                    o += snprintf(line + o, sizeof line - (size_t)o, " %s %.1f", nm[st], 100.0 * by[k][st] / tot[k]);
+            fprintf(stderr, "[sprof] %c%u (slot %u, %u smp):%s | cpu %.1f\n",
+                    s_sprof[k].kind, s_sprof[k].who, k, tot[k], line, cpu_all);
+            for (int r = 0; r < 6; r++) {
+                unsigned best = 0, bi = 0;
+                for (unsigned i = 0; i < SPROF_KEYS; i++)
+                    if ((key[i] >> 58) == k && hit[i] > best) { best = hit[i]; bi = i; }
+                if (!best || best * 200 < tot[k]) break;       /* under 0.5 % */
+                fprintf(stderr, "[sprof]     %5.1f%%  %s img=0x%X pc=0x%05X\n", 100.0 * best / tot[k],
+                        nm[(key[bi] >> 54) & 15], (unsigned)((key[bi] >> 22) & 0xFFFFFFFFu),
+                        (unsigned)(key[bi] & 0x3FFFFFu));
+                hit[bi] = 0;
+            }
+        }
+#ifdef __SWITCH__
+        {
+            double ld[4];
+            sprof_core_load(ld);
+            fprintf(stderr, "[sprof] cores busy (all threads): c0 %.1f c1 %.1f c2 %.1f c3 %.1f | registered threads cpu sum %.1f\n",
+                    ld[0], ld[1], ld[2], ld[3], reg_tot);
+        }
+#endif
+        for (unsigned w = 0; w < SPROF_WIDS; w++) {
+            const uint64_t runs = SP_TAKE(s_sp_runs[w]);
+            const uint64_t empty = SP_TAKE(s_sp_empty[w]), wake = SP_TAKE(s_sp_wake[w]),
+                           slow = SP_TAKE(s_sp_wake_slow[w]), run = SP_TAKE(s_sp_run[w]),
+                           wmax = SP_TAKE(s_sp_wake_max[w]), rmax = SP_TAKE(s_sp_run_max[w]);
+            if (!runs) continue;
+            fprintf(stderr, "[sprof] pm wid=%u: %.0f runs/s (%.0f%% found no work), wake avg %llu us max %llu us"
+                            " (%llu over 2 ms), run avg %llu us max %llu us, %.1f%% of a thread\n",
+                    w, (double)runs / secs, 100.0 * (double)empty / (double)runs,
+                    (unsigned long long)(wake / runs), (unsigned long long)wmax, (unsigned long long)slow,
+                    (unsigned long long)(run / runs), (unsigned long long)rmax,
+                    (double)run / (secs * 1e4));
+        }
+        { const uint64_t pass = SP_TAKE(s_sp_pass), kp = SP_TAKE(s_sp_kickpass),
+                         d = SP_TAKE(s_sp_disp), dp = SP_TAKE(s_sp_disp_probe);
+          fprintf(stderr, "[sprof] kernel: %.0f passes/s (%.0f kick), %.0f dispatches/s (%.0f by idle probe)\n",
+                  (double)pass / secs, (double)kp / secs, (double)d / secs, (double)dp / secs); }
+        fflush(stderr);
+    }
+    return NULL;
+}
+
+void sprof_thread(char kind, uint32_t who)
+{
+    if (s_sprof_period < 0) {
+        pthread_mutex_lock(&s_sprof_reg);
+        if (s_sprof_period < 0) {
+            const char* e = getenv("SPU_PROF");
+            int period = e ? atoi(e) : 0;
+            if (period > 0) {
+                pthread_t th;
+                if (pthread_create(&th, NULL, sprof_sampler, NULL) == 0) pthread_detach(th);
+                else period = 0;
+            }
+            s_sprof_period = period > 0 ? period : 0;
+        }
+        pthread_mutex_unlock(&s_sprof_reg);
+    }
+    if (s_sprof_period <= 0 || t_sprof) return;
+    pthread_mutex_lock(&s_sprof_reg);
+    for (unsigned k = 0; k < SPROF_SLOTS; k++)
+        if (!s_sprof[k].used) {
+            sprof_slot* s = &s_sprof[k];
+            s->st = SPROF_OUT; s->arg = 0; s->ctx = NULL; s->br_pc = 0;
+            s->kind = kind; s->who = who;
+            s->tick = 0; s->tick_ok = 0;
+#ifdef __SWITCH__
+            s->nxh = threadGetCurHandle();
+#endif
+            s->used = 1;
+            t_sprof = s;
+            break;
+        }
+    pthread_mutex_unlock(&s_sprof_reg);
+}
+
+void sprof_thread_exit(void)
+{
+    sprof_slot* s = t_sprof;
+    if (s) { t_sprof = NULL; s->used = 0; }
+}
+#endif /* !_WIN32 */
