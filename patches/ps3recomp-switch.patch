diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index f073f327..1d7837e2 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -2166,6 +2166,145 @@ static void wprof_note_walker(void)
     }
     pthread_detach(t);
 }
+#elif defined(__SWITCH__)
+/* 57a: Switch version of the walker profiler. RSX_WALKER_PROF="<start_s>:<seconds>"
+ * (e.g. "160:12"). The first thread to drain the FIFO is the one sampled:
+ * starting <start_s> seconds after it arms, a sampler thread pauses it every
+ * millisecond (svcSetThreadActivity), reads its registers (svcGetThreadContext3)
+ * and its frame-pointer chain, and resumes it. Samples are aggregated into two
+ * static tables keyed by offset from __start__ (the NRO image base):
+ * exclusive (pc) and inclusive (pc, lr and every return address, once per
+ * sample). At the end of the window the top entries go to stderr as [wprof]
+ * lines. libnx declared by hand (its u8..u64 clash with the runtime's), as in
+ * spu_prof_impl.inc. Diagnostic only, off unless RSX_WALKER_PROF is set. */
+#include <pthread.h>
+#include <time.h>
+/* 57a: mirror of libnx ThreadContext (switch/arm/thread_context.h). */
+typedef struct {
+    uint64_t cpu_gprs[29];
+    uint64_t fp;
+    uint64_t lr;
+    uint64_t sp;
+    uint64_t pc;                         /* CpuRegister pc (.x) */
+    uint32_t psr;
+    __attribute__((aligned(16))) unsigned char fpu_gprs[32][16];
+    uint32_t fpcr;
+    uint32_t fpsr;
+    uint64_t tpidr;
+} wprof_nx_ctx;
+_Static_assert(sizeof(wprof_nx_ctx) == 0x320, "57a: ThreadContext layout");
+extern uint32_t threadGetCurHandle(void);
+extern uint32_t svcSetThreadActivity(uint32_t handle, uint32_t activity); /* ThreadActivity */
+extern uint32_t svcGetThreadContext3(wprof_nx_ctx* ctx, uint32_t handle);
+extern char __start__[];
+enum { WPROF_RUNNABLE = 0, WPROF_PAUSED = 1 };  /* ThreadActivity_Runnable / _Paused */
+enum { WPROF_HSIZE = 8192, WPROF_CHAIN = 8, WPROF_TOP_X = 60, WPROF_TOP_I = 120 };
+static atomic_int s_wprof_state;     /* 0 unset, 1 armed, 2 done */
+static uint32_t s_wprof_handle;
+static int s_wprof_start_s, s_wprof_secs;
+static u64 s_wprof_armed_ns;
+/* 57a: open-addressed tables, reserved statically (no malloc while sampling). */
+static uintptr_t s_wprof_xkey[WPROF_HSIZE], s_wprof_ikey[WPROF_HSIZE];
+static uint32_t  s_wprof_xcnt[WPROF_HSIZE], s_wprof_icnt[WPROF_HSIZE];
+static unsigned char s_wprof_taken[WPROF_HSIZE];
+static void wprof_hadd(uintptr_t* key, uint32_t* cnt, uintptr_t off)
+{
+    uint32_t h = (uint32_t)(((uint64_t)(off >> 2) * 0x9E3779B97F4A7C15ull) >> 51) & (WPROF_HSIZE - 1);
+    for (unsigned p = 0; p < WPROF_HSIZE; p++, h = (h + 1) & (WPROF_HSIZE - 1)) {
+        if (cnt[h] == 0) { key[h] = off; cnt[h] = 1; return; }
+        if (key[h] == off) { cnt[h]++; return; }
+    }
+    /* full: dropped */
+}
+static void wprof_dump_top(const char* tag, const uintptr_t* key, const uint32_t* cnt, int top)
+{
+    memset(s_wprof_taken, 0, sizeof s_wprof_taken);
+    for (int k = 0; k < top; k++) {
+        int best = -1;
+        for (int i = 0; i < WPROF_HSIZE; i++)
+            if (cnt[i] && !s_wprof_taken[i] && (best < 0 || cnt[i] > cnt[best])) best = i;
+        if (best < 0) break;
+        s_wprof_taken[best] = 1;
+        fprintf(stderr, "[wprof] %s %llx %u\n", tag, (unsigned long long)key[best], cnt[best]);
+    }
+}
+static void* wprof_thread(void* arg)
+{
+    (void)arg;
+    const struct timespec poll = {0, 100000000}, tick = {0, 1000000};
+    const u64 start_ns = s_wprof_armed_ns + (u64)s_wprof_start_s * 1000000000ULL;
+    while (get_timestamp_ns() < start_ns) nanosleep(&poll, NULL);
+    const uintptr_t base = (uintptr_t)__start__;
+    const uint32_t h = s_wprof_handle;
+    const u64 deadline = get_timestamp_ns() + (u64)s_wprof_secs * 1000000000ULL;
+    unsigned long long samples = 0, fails = 0;
+    static wprof_nx_ctx ctx;
+    do {
+        uintptr_t addr[2 + WPROF_CHAIN];
+        unsigned na = 0;
+        /* 57a: while the walker is paused: no malloc, no printf, no locks. */
+        if (svcSetThreadActivity(h, WPROF_PAUSED) != 0) { fails++; nanosleep(&tick, NULL); continue; }
+        if (svcGetThreadContext3(&ctx, h) == 0) {
+            const uintptr_t sp = (uintptr_t)ctx.sp;
+            uintptr_t fp = (uintptr_t)ctx.fp;
+            addr[na++] = (uintptr_t)ctx.pc;
+            addr[na++] = (uintptr_t)ctx.lr;
+            for (unsigned d = 0; d < WPROF_CHAIN; d++) {
+                if ((fp & 15u) || fp < sp || fp >= sp + 0x1000000u) break;
+                const uintptr_t next = ((const uintptr_t*)fp)[0];
+                const uintptr_t ret  = ((const uintptr_t*)fp)[1];
+                if (!ret) break;
+                addr[na++] = ret;
+                if (next <= fp) break;
+                fp = next;
+            }
+        } else {
+            fails++;
+        }
+        if (svcSetThreadActivity(h, WPROF_RUNNABLE) != 0) fails++;
+        if (na) {
+            samples++;
+            wprof_hadd(s_wprof_xkey, s_wprof_xcnt, addr[0] - base);
+            for (unsigned i = 0; i < na; i++) {
+                int dup = 0;
+                for (unsigned j = 0; j < i; j++) if (addr[j] == addr[i]) { dup = 1; break; }
+                if (!dup) wprof_hadd(s_wprof_ikey, s_wprof_icnt, addr[i] - base);
+            }
+        }
+        nanosleep(&tick, NULL);
+    } while (get_timestamp_ns() < deadline);
+    fprintf(stderr, "[wprof] samples %llu fails %llu start_s %d secs %d base %p\n",
+            samples, fails, s_wprof_start_s, s_wprof_secs, (void*)base);
+    wprof_dump_top("X", s_wprof_xkey, s_wprof_xcnt, WPROF_TOP_X);
+    wprof_dump_top("I", s_wprof_ikey, s_wprof_icnt, WPROF_TOP_I);
+    fflush(stderr);
+    atomic_store(&s_wprof_state, 2);
+    return NULL;
+}
+static void wprof_note_walker(void)
