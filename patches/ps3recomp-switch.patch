+ * process; -1 when the core cannot be visited (core 3 is the system's). */
+static void sprof_core_load(double load[4])
+{
+    int32_t pref; uint64_t mask;
+    for (unsigned c = 0; c < 4; c++) load[c] = -1;
+    if (svcGetThreadCoreMask(&pref, &mask, SPROF_CUR_THREAD) != 0) return;
+    for (unsigned c = 0; c < 4; c++) {
