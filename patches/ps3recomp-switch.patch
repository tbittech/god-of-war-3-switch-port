+extern uint32_t svcGetThreadCoreMask(int32_t* preferred_core, uint64_t* affinity_mask, uint32_t handle);
+extern uint32_t svcGetCurrentProcessorNumber(void);
+extern uint64_t svcGetSystemTick(void);
+extern void     svcSleepThread(int64_t nano);
+#define SPROF_TICK_HZ 19200000.0
