+{
+    static int s_warned;
+    const uint32_t rc = h ? svcGetInfo(out, 25u /* ThreadTickCount (13.0.0+; 0xF0000002 was removed) */, h, ~0ull) : 0xFFFFFFFFu;
+    if (rc && !s_warned) {
+        s_warned = 1;
+        uint64_t self = 0;
+        const uint32_t rc_self = svcGetInfo(&self, 25u, SPROF_CUR_THREAD, ~0ull);
+        fprintf(stderr, "[sprof] ThreadTickCount failed: rc=0x%X h=0x%X (own pseudo-handle: rc=0x%X ticks=%llu, own handle 0x%X)\n",
+                rc, h, rc_self, (unsigned long long)self, threadGetCurHandle());
+    }
+    return rc == 0;
