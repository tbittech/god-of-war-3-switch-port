index 00000000..48bb9d3a
--- /dev/null
+++ b/include/ps3emu/spu_prof.h
@@ -0,0 +1,91 @@
+/* SPU_PROF=<seconds>: where the SPU-side host threads spend wall time.
+ *
+ * Every 2 ms a sampler reads one state word per registered thread (SPURS
+ * policy-module workers 'W', the SPURS kernel coordinator 'K', async task
+ * threads 'T', drain workers 'D') and every <seconds> prints, per thread, the
+ * share of each state and the top places:
+ *   idle      waiting for a dispatch
+ *   dispatch  bookkeeping between a wake and the module run
+ *   run       in lifted code (place = last indirect-branch target)
+ *   interp    in the SPU interpreter (place = image, 1 KB page of local store)
+ *   chwait    blocked reading a channel (place = channel)
+ *   lock      waiting for a host lock
+ *   sigwait   a task waiting for its taskset signal
+ *   ksleep / kscan   the kernel coordinator's timed wait / workload scan
+ * plus, per workload, how long a policy-module run waited between the kernel
+ * marking its slot busy and the worker starting it, and how long it ran.
+ *
+ * Unset, every hook is one thread-local load. POSIX hosts only. */
+#ifndef PS3EMU_SPU_PROF_H
+#define PS3EMU_SPU_PROF_H
+#include <stdint.h>
+
+enum { SPROF_OUT = 0, SPROF_IDLE, SPROF_DISPATCH, SPROF_RUN, SPROF_INTERP,
+       SPROF_CHWAIT, SPROF_LOCK, SPROF_SIGWAIT, SPROF_KSLEEP, SPROF_KSCAN,
+       SPROF_NSTATES };
+
+#ifdef _WIN32
+static inline void     sprof_thread(char k, uint32_t w) { (void)k; (void)w; }
+static inline void     sprof_thread_exit(void) {}
+static inline void     sprof_set(uint32_t st, uint32_t arg) { (void)st; (void)arg; }
+static inline uint64_t sprof_push(uint32_t st, uint32_t arg, void* ctx) { (void)st; (void)arg; (void)ctx; return 0; }
+static inline void     sprof_pop(uint64_t o) { (void)o; }
+static inline void     sprof_branch(int img, uint32_t pc) { (void)img; (void)pc; }
+static inline uint64_t sprof_now_us(void) { return 0; }
+static inline void     sprof_pm_run(uint32_t wid, uint64_t w, uint64_t r, unsigned p) { (void)wid; (void)w; (void)r; (void)p; }
+static inline void     sprof_kernel_pass(int k) { (void)k; }
+static inline void     sprof_kernel_dispatch(int k) { (void)k; }
+#else
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct sprof_slot {
+    volatile uint32_t st, arg;
+    void* volatile    ctx;        /* spu_context of the last interpreter entry */
+    volatile uint32_t br_pc;      /* last indirect-branch target since the run began */
+    volatile int      br_img;
+    volatile int      used;
+    char              kind;
+    uint32_t          who;
+    uint32_t          nxh;        /* Switch: thread handle, for its CPU ticks */
+    int               tick_ok;    /* tick holds a reading */
+    uint64_t          tick;       /* CPU ticks at the last report */
+} sprof_slot;
+extern __thread sprof_slot* t_sprof;
+
+void     sprof_thread(char kind, uint32_t who);   /* register the calling thread */
+void     sprof_thread_exit(void);
+uint64_t sprof_now_us(void);                      /* 0 when the profiler is off */
+void     sprof_pm_run(uint32_t wid, uint64_t wake_us, uint64_t run_us, unsigned polls);
+void     sprof_kernel_pass(int kick_pass);
+void     sprof_kernel_dispatch(int kicked);
+
+static inline void sprof_set(uint32_t st, uint32_t arg)
+{
+    sprof_slot* s = t_sprof;
+    if (s) { s->arg = arg; s->br_pc = 0; s->st = st; }
+}
+static inline uint64_t sprof_push(uint32_t st, uint32_t arg, void* ctx)
+{
+    sprof_slot* s = t_sprof;
+    if (!s) return 0;
+    const uint64_t old = ((uint64_t)s->st << 32) | s->arg;
+    if (ctx) s->ctx = ctx;
+    s->arg = arg; s->st = st;
+    return old;
+}
+static inline void sprof_pop(uint64_t old)
+{
+    sprof_slot* s = t_sprof;
+    if (s) { s->arg = (uint32_t)old; s->st = (uint32_t)(old >> 32); }
+}
+static inline void sprof_branch(int img, uint32_t pc)
+{
+    sprof_slot* s = t_sprof;
+    if (s) { s->br_img = img; s->br_pc = pc; }
+}
+#ifdef __cplusplus
+}
+#endif
+#endif /* _WIN32 */
+#endif
